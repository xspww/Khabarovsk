# Example environment overrides for Cronus Launcher
# Copy to .env (ignored by git) or export as real env vars

# Update behavior: auto | notify | off
CRONUS_UPDATE_MODE=auto

# Override GitHub repo for updater / build (owner/repo)
CRONUS_UPDATE_REPO=your-github-username/Roblox-Auto-Rejoin-windows

# Build commit override (used by ops/build_exe.py)
# CRONUS_BUILD_COMMIT=

# Override user data root (default: %LOCALAPPDATA%\Cronus Launcher)
# CRONUS_USER_ROOT=

# Console / dev toggles (optional)
# CRONUS_CONSOLE_ACTIVITY=0
# CRONUS_CONSOLE_COLOR=1
