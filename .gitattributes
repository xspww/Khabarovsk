# Auto detect text files and normalize to LF on commit
* text=auto eol=lf

# Windows batch scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.zip binary

# Lua files as text
*.lua text eol=lf
